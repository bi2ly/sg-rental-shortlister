# Copy this file to .env and fill in your values. .env is never committed.

# Apify API token (apify.com -> Settings -> API & Integrations)
APIFY_TOKEN=

# Optional: data.gov.sg API key for higher rate limits (not required)
DATAGOV_API_KEY=

# Telegram: bot token from @BotFather, and your own chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URA Data Service access key (once received by email)
URA_ACCESS_KEY=
